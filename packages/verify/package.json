{
  "name": "@kovojs/verify",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kovojs/kovo.git"
  },
  "bin": {
    "kovo-verify": "./src/bin.ts"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./internal/translation": "./src/translation.ts"
  },
  "publishConfig": {
    "bin": {
      "kovo-verify": "./dist/bin.mjs"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./internal/translation": {
        "types": "./dist/translation.d.mts",
        "default": "./dist/translation.mjs"
      }
    }
  },
  "scripts": {
    "build:dist": "vp pack src/bin.ts src/index.ts src/translation.ts --dts",
    "prepack": "pnpm run build:dist"
  },
  "dependencies": {
    "es-module-lexer": "2.1.0"
  },
  "devDependencies": {
    "vitest": "4.1.8"
  }
}
