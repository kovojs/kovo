{
  "name": "@kovojs/cli",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kovojs/kovo.git"
  },
  "bin": {
    "kovo": "./src/bin.ts"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/api.ts",
    "./internal": "./src/index.ts"
  },
  "publishConfig": {
    "bin": {
      "kovo": "./dist/bin.mjs"
    },
    "exports": {
      ".": {
        "types": "./dist/api.d.mts",
        "default": "./dist/api.mjs"
      },
      "./internal": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "build:dist": "vp pack src/api.ts src/bin.ts src/index.ts src/test-runner-config.ts src/test-runtime-bootstrap.ts src/commands/sound-subset.mjs --dts && node ../../scripts/agent-docs-snapshot.mjs",
    "prepack": "pnpm run build:dist"
  },
  "dependencies": {
    "@kovojs/compiler": "workspace:*",
    "@kovojs/core": "workspace:*",
    "@kovojs/drizzle": "workspace:*",
    "@kovojs/headless-ui": "workspace:*",
    "@kovojs/server": "workspace:*",
    "@kovojs/ui": "workspace:*",
    "drizzle-orm": "1.0.0-rc.4",
    "esbuild": "0.28.1",
    "parse5": "8.0.1",
    "sigstore": "5.0.0",
    "typescript": "6.0.3",
    "vite-plus": "0.1.24"
  },
  "devDependencies": {
    "vitest": "4.1.8"
  },
  "kovoBuildProvenance": {
    "securityGuarantees": {
      "schema": "kovo.security.guarantees/v1",
      "canonicalHash": "sha256:a74f656197edd4973cde5259cf29181b3a73a6f9ae5c2960b674f81ff05e21fb"
    }
  }
}
