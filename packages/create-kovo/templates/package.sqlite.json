{
  "name": "{{name}}",
  "private": true,
  "type": "module",
  "scripts": {
    "build:prod": "kovo build ./src/app.tsx",
    "check": "kovo check",
    "check:endpoint-posture": "kovo check endpoint-posture",
    "dev": "kovo dev ./src/app.tsx",
    "serve": "pnpm run build:prod && NODE_ENV=production node dist/server/server.mjs",
    "start": "NODE_ENV=production node dist/server/server.mjs",
    "test": "kovo test"
  },
  "dependencies": {
    "@kovojs/better-auth": "{{kovo_better_auth_version}}",
    "@kovojs/browser": "{{kovo_browser_version}}",
    "@kovojs/core": "{{kovo_core_version}}",
    "@kovojs/drizzle": "{{kovo_drizzle_version}}",
    "@kovojs/server": "{{kovo_server_version}}",
    "@kovojs/style": "{{kovo_style_version}}",
    "@kovojs/ui": "{{kovo_ui_version}}",
    "@node-rs/argon2": "2.0.2",
    "better-sqlite3": "12.11.1",
    "drizzle-orm": "1.0.0-rc.4",
    "pgsql-ast-parser": "12.0.2"
  },
  "devDependencies": {
    "@kovojs/cli": "{{kovo_cli_version}}",
    "@kovojs/test": "{{kovo_test_version}}",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "25.9.2",
    "@typescript/native-preview": "7.0.0-dev.20260610.1",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vite-plus": "0.1.24",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "packageManager": "{{package_manager}}",
  "pnpm": {
    "ignoredBuiltDependencies": ["esbuild"],
    "onlyBuiltDependencies": ["@node-rs/argon2", "better-sqlite3"],
    "overrides": {
      "@node-rs/argon2": "2.0.2",
      "better-sqlite3": "12.11.1"
    }
  },
  "kovo": {
    "lifecyclePolicy": "strict-v1",
    "soundSubset": {
      "securitySurface": [
        "src/app.test.ts",
        "src/app.tsx",
        "src/auth.ts",
        "src/components/auth-forms.tsx",
        "src/components/contacts.tsx",
        "src/db.ts",
        "src/endpoint-posture.test.ts",
        "src/kovo.ts",
        "src/model.ts",
        "src/mutations.ts",
        "src/queries.ts",
        "src/schema.ts"
      ]
    }
  }
}
