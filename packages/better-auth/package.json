{
  "name": "@kovojs/better-auth",
  "version": "0.3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kovojs/kovo.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./postgres": "./src/public-postgres.ts",
    "./sqlite": "./src/public-sqlite.ts",
    "./generated": "./src/generated.ts",
    "./generated/postgres": "./src/generated-postgres.ts",
    "./generated/sqlite": "./src/generated-sqlite.ts",
    "./internal": "./src/internal.ts",
    "./internal/server-mount-adapter": "./src/internal/server-mount-adapter.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./postgres": {
        "types": "./dist/public-postgres.d.mts",
        "default": "./dist/public-postgres.mjs"
      },
      "./sqlite": {
        "types": "./dist/public-sqlite.d.mts",
        "default": "./dist/public-sqlite.mjs"
      },
      "./generated": {
        "types": "./dist/generated.d.mts",
        "default": "./dist/generated.mjs"
      },
      "./generated/postgres": {
        "types": "./dist/generated-postgres.d.mts",
        "default": "./dist/generated-postgres.mjs"
      },
      "./generated/sqlite": {
        "types": "./dist/generated-sqlite.d.mts",
        "default": "./dist/generated-sqlite.mjs"
      },
      "./internal": {
        "types": "./dist/internal.d.mts",
        "default": "./dist/internal.mjs"
      },
      "./internal/server-mount-adapter": {
        "types": "./dist/internal/server-mount-adapter.d.mts",
        "default": "./dist/internal/server-mount-adapter.mjs"
      }
    }
  },
  "scripts": {
    "build:dist": "vp pack src/generated-postgres.ts src/generated-sqlite.ts src/generated.ts src/index.ts src/internal.ts src/internal/runtime-lock.ts src/internal/server-mount-adapter.ts src/public-postgres.ts src/public-sqlite.ts --dts",
    "prepack": "pnpm run build:dist"
  },
  "dependencies": {
    "@kovojs/core": "workspace:*",
    "better-auth": "1.6.17",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@kovojs/server": "workspace:*",
    "vitest": "4.1.8"
  },
  "peerDependencies": {
    "@kovojs/server": "workspace:*"
  },
  "kovoPublish": {
    "extraEntries": [
      "./src/internal/runtime-lock.ts"
    ]
  }
}
