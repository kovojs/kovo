{
  "$comment": "Independent semantic execution vectors for Plan 3 cost gates. Budget edits cannot change what a gate runs.",
  "schema": "kovo.plan3-security-gate-commands/v1",
  "gates": [
    {
      "id": "cost-budget-manifest",
      "execution": "self-check"
    },
    {
      "id": "artifact-provenance-build",
      "steps": [
        {
          "command": [
            "pnpm",
            "exec",
            "vitest",
            "--run",
            "--no-file-parallelism",
            "packages/cli/src/artifact-provenance.test.ts",
            "--reporter=dot"
          ]
        },
        {
          "buildIntegrated": true,
          "command": [
            "pnpm",
            "exec",
            "vitest",
            "--run",
            "--no-file-parallelism",
            "packages/cli/src/index.kovo-build.test.ts",
            "--reporter=dot",
            "-t",
            "emits byte-stable artifact provenance across two no-op production rebuilds"
          ]
        }
      ]
    },
    {
      "id": "security-guarantee",
      "steps": [
        {
          "command": ["node", "scripts/check-security-guarantee.mjs"]
        }
      ]
    },
