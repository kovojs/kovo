{
  "schema": "kovo-devex-ci-policy/v2",
  "budgets": {
    "perPullRequestRunnerMinutes": 138,
    "nightlyRunnerMinutes": 300
  },
  "pullRequestDelivery": {
    "workflow": ".github/workflows/ci.yml",
    "transport": "github-check-step-summary",
    "writePermissions": false,
    "requiredSignals": ["public-surface", "docs-freshness", "speed-deltas"]
  },
  "releaseAuthority": {
    "workflow": ".github/workflows/release.yml",
    "requiredWorkflowId": 322844190,
    "requiredWorkflowName": "DevEx Nightly",
    "requiredWorkflowPath": ".github/workflows/devex-nightly.yml",
    "requiredBranch": "main"
  },
  "gates": [
    {
      "id": "pr-known-failures",
      "cadence": "per-pr",
      "scope": "step",
      "workflow": ".github/workflows/ci.yml",
      "job": "publish-readiness",
      "budgetMinutes": 78,
      "runnerCount": 1,
      "commands": [
        "timeout --kill-after=30s 78m vp exec pnpm run test:devex-known-failures-available"
      ],
      "prVisible": false
    },
    {
      "id": "pr-scorecard",
      "cadence": "per-pr",
      "scope": "job",
      "workflow": ".github/workflows/ci.yml",
      "job": "devex-scorecard",
      "budgetMinutes": 60,
      "timeoutMinutes": 60,
      "runnerCount": 1,
      "commands": [
        "vp exec node scripts/devex-benchmark.mjs --prepare-kovo-scenario",
        "vp exec node scripts/devex-benchmark.mjs --scenario .release/devex/kovo-packed-scenario.json --samples 1 --output \"$RUNNER_TEMP/kovo-devex-pr/benchmark.json\"",
        "vp exec node scripts/devex-pr-report.mjs"
      ],
      "prVisible": true,
      "runWhenDependenciesFail": true
    },
    {
      "id": "nightly-package-producer",
      "cadence": "nightly",
      "scope": "job",
      "workflow": ".github/workflows/devex-nightly.yml",
      "job": "package-producer",
      "budgetMinutes": 40,
      "timeoutMinutes": 40,
      "runnerCount": 1,
      "commands": ["vp exec pnpm run check:publish"],
      "prVisible": false,
      "releaseRequired": true
    },
    {
      "id": "nightly-benchmark",
      "cadence": "nightly",
      "scope": "job",
      "workflow": ".github/workflows/devex-nightly.yml",
      "job": "benchmark",
      "budgetMinutes": 100,
      "timeoutMinutes": 100,
      "runnerCount": 1,
      "commands": [
        "vp exec node scripts/devex-benchmark.mjs --prepare-kovo-scenario",
        "vp exec node scripts/devex-benchmark.mjs --scenario .release/devex/kovo-packed-scenario.json --samples 5 --output \"$RUNNER_TEMP/kovo-devex-baseline/benchmark.json\" --evaluate --require-ratified"
      ],
      "prVisible": false,
      "preserveReportOnFailure": true,
      "releaseRequired": true
    },
    {
      "id": "nightly-packed-journeys",
      "cadence": "nightly",
      "scope": "job",
      "workflow": ".github/workflows/devex-nightly.yml",
      "job": "packed-journeys",
      "budgetMinutes": 90,
      "timeoutMinutes": 90,
      "runnerCount": 1,
      "commands": [
        "vp exec node scripts/golden-journey.mjs --scenario release-scorecard --samples 5 --report \"$RUNNER_TEMP/kovo-devex-golden/report.json\" --artifacts \"$RUNNER_TEMP/kovo-devex-golden/failures\" --budgets devex-budgets.json --evaluate --require-ratified"
      ],
      "prVisible": false,
      "preserveReportOnFailure": true,
      "requiresBrowser": true,
      "releaseRequired": true
    },
    {
      "id": "nightly-full-catalog",
      "cadence": "nightly",
      "scope": "job",
      "workflow": ".github/workflows/devex-nightly.yml",
      "job": "full-catalog",
      "budgetMinutes": 60,
      "timeoutMinutes": 60,
      "runnerCount": 1,
      "commands": [
        "vp exec node scripts/full-catalog-reproducer.mjs --samples 5 --output \"$RUNNER_TEMP/kovo-devex-full-catalog/report.json\" --artifacts \"$RUNNER_TEMP/kovo-devex-full-catalog/failures\""
      ],
      "prVisible": false,
      "preserveReportOnFailure": true,
      "releaseRequired": true
    },
    {
      "id": "manual-hosted-ratification",
      "cadence": "manual",
      "scope": "job",
      "workflow": ".github/workflows/devex-nightly.yml",
      "job": "hosted-ratification",
      "budgetMinutes": 240,
      "timeoutMinutes": 240,
      "runnerCount": 1,
      "commands": [
        "vp exec node scripts/devex-benchmark.mjs --prepare-kovo-scenario",
        "vp exec node scripts/devex-benchmark.mjs --scenario .release/devex/kovo-packed-scenario.json --samples 5 --output \"$RUNNER_TEMP/kovo-devex-ratification/benchmark.json\" --evaluate",
        "vp exec node scripts/golden-journey.mjs --scenario release-scorecard --samples 5 --report \"$RUNNER_TEMP/kovo-devex-ratification/golden/report.json\" --artifacts \"$RUNNER_TEMP/kovo-devex-ratification/golden/failures\" --budgets devex-budgets.json --evaluate",
        "vp exec node scripts/full-catalog-reproducer.mjs --samples 5 --output \"$RUNNER_TEMP/kovo-devex-ratification/full-catalog/report.json\" --artifacts \"$RUNNER_TEMP/kovo-devex-ratification/full-catalog/failures\"",
        "vp exec node scripts/devex-benchmark.mjs --ratify --budgets devex-budgets.json --baseline \"$RUNNER_TEMP/kovo-devex-ratification/benchmark.json\" --proposal \"$RUNNER_TEMP/kovo-devex-ratification/proposals/benchmark.json\" --baseline-record-path baselines/devex-hosted-benchmark-v1.json --baseline \"$RUNNER_TEMP/kovo-devex-ratification/golden/report.json\" --proposal \"$RUNNER_TEMP/kovo-devex-ratification/proposals/golden-journey.json\" --baseline-record-path baselines/devex-hosted-golden-journey-v1.json --baseline \"$RUNNER_TEMP/kovo-devex-ratification/full-catalog/report.json\" --proposal \"$RUNNER_TEMP/kovo-devex-ratification/proposals/full-catalog.json\" --baseline-record-path baselines/devex-hosted-full-catalog-v1.json --write",
        "vp exec node scripts/devex-benchmark.mjs --check-budgets"
      ],
      "prVisible": false,
      "preserveReportOnFailure": true,
      "requiresBrowser": true
    }
  ]
}
