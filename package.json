{
  "name": "kovo-monorepo",
  "version": "0.3.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*",
    "conformance/*",
    "site",
    "tests/integration"
  ],
  "type": "module",
  "scripts": {
    "acceptance": "pnpm run check && pnpm run check:api-surface && pnpm run test && pnpm run test:browser && pnpm run test:gallery-browser && pnpm run test:integration && pnpm run check:build && pnpm run check:publish && pnpm run test:p10-perf && pnpm run test:compiler-perf && pnpm run test:conformance && pnpm run check:kovo && pnpm run test:authz-paranoid",
    "check": "pnpm run check:inline-loader && pnpm run check:inline-loader:trusted-types && pnpm run check:plan3-cost-budgets && pnpm run check:imports && pnpm run check:no-committed-generated && pnpm run check:generated-artifacts && pnpm run check:spec-index && pnpm run check:spec-conformance-closure && pnpm run check:raw-diagnostic-channels && pnpm run check:security-ledger-index && pnpm run check:authorization-matrix && pnpm run check:rls-emission-door && pnpm run check:sink-policy && pnpm run check:c9-sink-inventory && pnpm run check:threat-matrix && pnpm run check:csrf-mint-delivery && pnpm run check:escape-census && pnpm run check:metric-e-rounds && pnpm run check:declassification-census && pnpm run check:security-event-answerability && pnpm run check:advisory-feed && pnpm run check:protocol-alphabet && pnpm run check:replay-model && pnpm run check:model-honesty-boundary && pnpm run check:label-clause-map && pnpm run check:artifact-provenance-build && pnpm run check:plan3-phase3-gates && pnpm run check:provenance-closure && pnpm run check:provenance-precision-register && pnpm run check:analyzable-fragment && pnpm run check:analyzer-soundness-oracle && pnpm run check:async-context-confinement && pnpm run check:cache-generality && pnpm run check:browser-posture-derivation && pnpm run check:grammar-containment && pnpm run check:decided-surface && pnpm run check:emission-constructor-closure && pnpm run check:single-choke && pnpm run check:crypto-boundary && pnpm run check:filesystem-boundary && pnpm run check:egress-boundary && pnpm run check:wire-input-boundary && pnpm run check:wire-output-boundary && pnpm run check:response-observation && pnpm run check:auth-provider-pin && pnpm run check:tcb-boundary && pnpm run check:analysis-time-closure && pnpm run check:security-guarantee && pnpm run check:security-brands && pnpm run check:fail-closed-classifiers && pnpm run check:classifier-verdict-routing && pnpm run check:derivation-rewitness-inventory && pnpm run check:runtime-tier-door-parity && pnpm run check:green-corpus && pnpm run check:security-coverage && pnpm run check:security-classifier-corpus && pnpm run check:security-test-builds && pnpm run check:security-gate-mutations && pnpm run check:security-fuzz-campaign && pnpm run check:fundamental-fixes-census && pnpm run check:capability-surface-census && pnpm run check:vp && vp run typecheck-examples",
    "check:api-surface": "node scripts/api-surface-gate.mjs && node scripts/api-decision-ledger.mjs && node scripts/api-migration-protocol.mjs && vitest --run scripts/api-surface-gate.test.mjs scripts/api-decision-ledger.test.mjs scripts/api-migration-protocol.test.mjs --reporter=dot",
    "check:api-surface:packed": "node scripts/packed-public-any-gate.mjs --tarball-dir .release/tarballs && vitest --run scripts/packed-public-any-gate.test.mjs --reporter=dot",
    "check:app-contract-g23": "node scripts/app-contract-g23-gate.mjs && vitest --run scripts/app-contract-g23-gate.test.mjs --reporter=dot",
    "check:app-contract-g23:packed": "node scripts/egress-floor.mjs --policy install -- node scripts/app-contract-g23-packed.mjs && vitest --run scripts/app-contract-g23-packed.test.mjs --reporter=dot",
    "check:app-contract-type-budgets": "node scripts/app-contract-type-budget-gate.mjs && vitest --run scripts/app-contract-type-budget-gate.test.mjs --reporter=dot",
    "check:auth-provider-pin": "node scripts/security-cost-budget-runner.mjs --gate auth-provider-pin",
    "check:analysis-time-closure": "node scripts/check-analysis-time-closure.mjs && vitest --run scripts/check-analysis-time-closure.test.mjs scripts/lib/pnpm-lock-packages.test.mjs scripts/lib/deterministic-tarball.test.mjs scripts/reproducible-pack.test.mjs --reporter=dot",
    "check:advisory-feed": "node scripts/security-cost-budget-runner.mjs --gate advisory-feed",
    "check:analyzable-fragment": "node scripts/security-cost-budget-runner.mjs --gate analyzable-fragment",
    "check:analyzer-soundness-oracle": "node scripts/analyzer-soundness-oracle.mjs && vitest --run scripts/analyzer-soundness-oracle.test.mjs packages/compiler/src/security-analyzer-soundness-oracle.test.ts --reporter=dot",
    "check:async-context-confinement": "node scripts/check-async-context-confinement.mjs && vitest --run scripts/check-async-context-confinement.test.mjs packages/server/src/async-context.test.ts --reporter=dot",
    "check:cache-generality": "node scripts/check-cache-generality.mjs && vitest --run scripts/check-cache-generality.test.mjs packages/core/src/internal/cache-influence.test.ts packages/compiler/src/cache-influence.security.test.ts packages/server/src/cache-generality-intermediary.security.test.ts --reporter=dot",
    "check:browser-posture-derivation": "node scripts/browser-posture-derivation-gate.mjs && vitest --run scripts/browser-posture-derivation-gate.test.mjs packages/compiler/src/browser-posture-manifest.security.test.ts packages/server/src/browser-response-posture.security.test.ts --reporter=dot",
    "check:artifact-provenance-build": "node scripts/security-cost-budget-runner.mjs --gate artifact-provenance-build",
    "check:authorization-matrix": "node scripts/security-cost-budget-runner.mjs --gate authorization-matrix",
    "check:build": "pnpm run check:inline-loader && node scripts/egress-floor.mjs --policy build -- vp run build",
    "check:build:ci": "node scripts/egress-floor.mjs --policy build -- vp run build",
    "check:c9-sink-inventory": "node scripts/security-cost-budget-runner.mjs --gate c9-sink-inventory",
    "check:certificate": "node scripts/security-cost-budget-runner.mjs --gate certificate",
    "check:certificate-module-identity": "node scripts/security-cost-budget-runner.mjs --gate certificate-module-identity",
    "check:external-evaluator-evidence": "node scripts/external-evaluator-evidence.mjs",
    "check:framework-export-posture": "node scripts/framework-export-posture-gate.mjs && vitest --run scripts/framework-export-posture-gate.test.mjs --reporter=dot",
    "check:generated-artifacts": "node scripts/check-generated-artifacts.mjs && vitest --run scripts/check-generated-artifacts.test.mjs scripts/generated-artifacts.test.mjs scripts/framework-export-posture-gate.test.mjs --reporter=dot",
    "check:grammar-containment": "node scripts/security-cost-budget-runner.mjs --gate grammar-containment",
    "check:label-clause-map": "node scripts/security-cost-budget-runner.mjs --gate label-clause-map",
    "check:threat-matrix": "vitest --run scripts/threat-matrix-gate.test.ts --reporter=dot",
    "check:csrf-mint-delivery": "node scripts/check-csrf-mint-delivery.mjs",
    "check:crypto-boundary": "node scripts/check-crypto-boundary.mjs && vitest --run scripts/check-crypto-boundary.test.mjs --reporter=dot",
    "check:declassification-census": "node scripts/security-cost-budget-runner.mjs --gate declassification-census",
    "check:decided-surface": "node scripts/security-cost-budget-runner.mjs --gate decided-surface",
    "check:decided-surface-artifact": "node scripts/decided-surface-gate.mjs --check-artifact",
    "test:devex-foundation-schema": "node scripts/devex-benchmark.mjs --check-budgets && node scripts/public-api-inventory.mjs --check && node scripts/known-failure-register.mjs --validate-schema && vitest --run scripts/devex-benchmark.test.mjs scripts/devex-dev-profile.test.mjs scripts/public-api-inventory.test.mjs scripts/known-failure-register.test.mjs --reporter=dot",
    "test:devex-known-failures-available": "node scripts/known-failure-register.mjs --run-available --cadence per-pr --packed-manifest .release/packed-packages.json",
    "test:devex-known-failures-nightly": "node scripts/known-failure-register.mjs --run-available --cadence nightly --packed-manifest .release/packed-packages.json",
    "test:devex-track2": "node scripts/devex-ci-policy.mjs && vitest --run scripts/devex-benchmark.test.mjs scripts/devex-ci-policy.test.mjs scripts/devex-golden-contract.test.mjs scripts/devex-pr-report.test.mjs scripts/full-catalog-reproducer.test.mjs scripts/full-catalog-known-failure.test.mjs scripts/golden-journey.test.mjs scripts/golden-journey/artifacts.test.mjs scripts/golden-journey/offline-agent.test.mjs scripts/golden-journey/packed-app.test.mjs scripts/lib/process-tree-rss.test.mjs --reporter=dot",
    "test:devex-offline-agent": "vitest --run scripts/golden-journey.test.mjs scripts/golden-journey/offline-agent.test.mjs scripts/egress-floor.test.mjs --reporter=dot",
    "test:devex-editor": "pnpm --filter kovo-diagnostics test && pnpm --filter kovo-diagnostics run package:check",
    "test:devex-offline-agent:packed": "node scripts/golden-journey.mjs --scenario offline-agent --packed-manifest .release/packed-packages.json",
    "check:security-event-answerability": "node scripts/security-cost-budget-runner.mjs --gate security-event-answerability",
    "check:protocol-alphabet": "node scripts/security-cost-budget-runner.mjs --gate protocol-alphabet",
    "check:model-honesty-boundary": "node scripts/security-cost-budget-runner.mjs --gate model-honesty-boundary",
    "check:capability-surface-census": "node scripts/capability-surface-census-gate.mjs",
    "check:exports": "node scripts/exported-symbols.mjs --duplicates --check",
    "precheck:imports": "pnpm run check:certificate",
    "check:imports": "node scripts/import-boundary.mjs",
    "check:pack-security": "node scripts/security-cost-budget-runner.mjs --gate pack-security",
    "check:plan3-cost-budgets": "node scripts/security-cost-budget-runner.mjs --check",
    "check:plan3-phase3-gates": "node scripts/security-cost-budget-runner.mjs --group phase3",
    "check:security-guarantee": "node scripts/security-cost-budget-runner.mjs --gate security-guarantee",
    "check:security-ledger-index": "node scripts/check-security-ledger-index.mjs",
    "check:security-gate-mutations": "node scripts/security-gate-mutations.mjs",
    "check:security-fuzz-campaign": "node scripts/security-fuzz-campaign.mjs --check",
    "check:security-brands": "node scripts/check-security-brands.mjs",
    "check:security-classifier-corpus": "node scripts/check-security-classifier-corpus.mjs",
    "check:security-coverage": "node scripts/security-coverage-gate.mjs",
    "check:security-convergence-baseline": "node scripts/security-convergence-baseline.mjs",
    "check:security-convergence-baseline-artifact": "node scripts/security-convergence-baseline.mjs --artifact",
    "check:fail-closed-classifiers": "node scripts/check-fail-closed-classifiers.mjs",
    "check:classifier-verdict-routing": "node scripts/check-classifier-verdict-routing.mjs",
    "check:derivation-rewitness-inventory": "node scripts/derivation-rewitness-inventory.mjs",
    "check:paranoid-classifiers": "KOVO_PARANOID=1 pnpm run check:fail-closed-classifiers && KOVO_PARANOID=1 pnpm run check:classifier-verdict-routing",
    "check:paranoid-runtime": "pnpm run test:authz-paranoid",
    "check:provenance-closure": "node scripts/security-cost-budget-runner.mjs --gate provenance-closure",
    "check:provenance-precision-register": "node scripts/security-cost-budget-runner.mjs --gate provenance-precision-register",
    "check:raw-diagnostic-channels": "node scripts/raw-diagnostic-channel-gate.mjs && vitest --run scripts/raw-diagnostic-channel-gate.test.mjs --reporter=dot",
    "check:response-observation": "node scripts/check-response-observation.mjs && vitest --run scripts/check-response-observation.test.mjs scripts/response-indistinguishability-timing-oracle.test.mjs packages/server/src/response-observation.test.ts --reporter=dot",
    "check:replay-model": "node scripts/security-cost-budget-runner.mjs --gate replay-model",
    "check:rls-emission-door": "node scripts/security-cost-budget-runner.mjs --gate rls-emission-door",
    "check:runtime-tier-door-parity": "node scripts/check-runtime-tier-door-parity.mjs && vitest --run scripts/check-runtime-tier-door-parity.test.mjs --reporter=dot",
    "check:green-corpus": "node scripts/check-green-corpus.mjs",
    "check:hermetic-proof-stage": "node scripts/security-cost-budget-runner.mjs --gate hermetic-proof-stage",
    "check:fundamental-fixes-census": "node scripts/fundamental-fixes-census-gate.mjs",
    "check:filesystem-boundary": "node scripts/check-filesystem-boundary.mjs",
    "check:egress-boundary": "node scripts/check-egress-boundary.mjs",
    "check:emission-constructor-closure": "node scripts/security-cost-budget-runner.mjs --gate emission-constructor-closure",
    "check:escape-census": "node scripts/security-cost-budget-runner.mjs --gate escape-census",
    "check:escape-census:baseline": "node scripts/escape-census-baseline.mjs",
    "check:metric-e-rounds": "node scripts/security-cost-budget-runner.mjs --gate metric-e-rounds",
    "check:wire-input-boundary": "node scripts/wire-input-boundary-gate.mjs && vitest --run scripts/wire-input-boundary-gate.test.mjs packages/core/src/internal/wire-input-grammar.test.ts --reporter=dot",
    "check:wire-output-boundary": "node scripts/check-wire-output-boundary.mjs",
    "check:tcb-boundary": "node scripts/check-tcb-boundary.mjs",
    "check:publish": "node scripts/egress-floor.mjs --policy publish -- node scripts/check-publish.mjs",
    "check:packed-drizzle-consumer": "node scripts/check-packed-drizzle-consumer.mjs && vitest --run scripts/check-packed-drizzle-consumer.test.mjs --reporter=dot",
    "check:security-test-builds": "node scripts/security-test-build-gate.mjs",
    "check:test-package-budget": "pnpm --filter @kovojs/test run build:dist && node scripts/check-test-package-budget.mjs && vitest --run scripts/check-test-package-budget.test.mjs --reporter=dot",
    "check:sink-policy": "node scripts/check-sink-policy-gate.mjs",
    "check:single-choke": "node scripts/check-single-choke.mjs",
    "check:spec-index": "node scripts/check-spec-index.mjs",
    "check:spec-conformance-closure": "node scripts/check-spec-conformance-closure.mjs && node scripts/run-spec-conformance-evidence-tests.mjs",
    "check:supply-chain": "node scripts/supply-chain-gates.mjs",
    "check:kovo": "vp run kovo-check",
    "check:no-committed-generated": "node scripts/no-committed-generated.mjs",
    "check:docs-samples:packed": "node --disable-warning=ExperimentalWarning --experimental-transform-types scripts/packed-doc-samples.mjs",
    "check:docs-snippets": "node scripts/package-front-door.mjs && node scripts/build-component-catalog.mjs && node site/scripts/code-snippets-check.mjs && node site/scripts/golden-recipes.mjs",
    "check:docs-snippets:dist": "pnpm --filter @kovojs/better-auth --filter @kovojs/browser --filter @kovojs/cli --filter @kovojs/compiler --filter @kovojs/core --filter @kovojs/drizzle --filter @kovojs/headless-ui --filter @kovojs/icons --filter @kovojs/server --filter @kovojs/style --filter @kovojs/test --filter @kovojs/ui --filter @kovojs/verify run build:dist && KOVO_DOC_SNIPPETS_USE_DIST=1 node site/scripts/code-snippets-check.mjs",
    "check:golden-recipes": "node site/scripts/golden-recipes.mjs",
    "check:vp": "vp check >/tmp/kovo-vp-check.log 2>&1 || { code=$?; cat /tmp/kovo-vp-check.log; exit $code; }",
    "check:inline-loader": "pnpm --filter @kovojs/browser run check:inline-loader",
    "check:inline-loader:trusted-types": "pnpm --filter @kovojs/browser run check:inline-loader:trusted-types",
    "ci:timing-report": "node scripts/ci-timing-report.mjs",
    "devex:benchmark": "node scripts/devex-benchmark.mjs",
    "devex:full-catalog": "node scripts/full-catalog-reproducer.mjs",
    "devex:golden-journey": "node scripts/golden-journey.mjs",
    "devex:inventory": "node scripts/public-api-inventory.mjs",
    "devex:known-failures": "pnpm run test:devex-known-failures-available",
    "devex:pr-report": "node scripts/devex-pr-report.mjs",
    "check:devex-ci-policy": "node scripts/devex-ci-policy.mjs",
    "bump": "node scripts/bump.mjs",
    "docs:serve": "pnpm run check:build && pnpm --filter @kovojs/site run build && HOST=0.0.0.0 node site/scripts/serve.mjs",
    "generate:provenance-relation": "node scripts/provenance-closure.mjs --write",
    "generate:decided-surface": "node scripts/decided-surface-gate.mjs --write",
    "generate:final-security-evidence": "node scripts/final-security-evidence.mjs --write",
    "generate:security-convergence-baseline": "node scripts/security-convergence-baseline.mjs --write",
    "generate:security-coverage": "node scripts/security-coverage-gate.mjs --write",
    "generate:capability-surface-census": "node scripts/capability-surface-census-gate.mjs --write",
    "generate:certificate": "node --experimental-strip-types scripts/kovo-certificate.mjs --write",
    "generate:cli-command-request": "node --disable-warning=ExperimentalWarning --experimental-transform-types scripts/generate-cli-command-request.mjs",
    "propose:certificate-policy": "node --experimental-strip-types scripts/kovo-certificate-policy.mjs --write",
    "generate:wire-input-boundary": "node scripts/wire-input-boundary-gate.mjs --write",
    "perf:fcp": "node scripts/fcp-harness.mjs",
    "test": "vitest --run --maxWorkers=1",
    "test:authz-paranoid": "node --disable-warning=ExperimentalWarning --experimental-strip-types packages/create-kovo/src/index.build.prod-artifact.paranoid-runtime-runner.ts",
    "test:browser": "vp run browser",
    "test:gallery-browser": "pnpm --filter @kovojs/example-gallery run test:browser",
    "test:examples-live": "pnpm --filter @kovojs/site run test:examples-live",
    "test:compiler-perf": "vp run compiler-perf",
    "test:conformance": "vp run conformance",
    "test:integration": "vp run integration",
    "test:p10-perf": "vp run p10-perf",
    "test:security-fuzz-nightly": "node scripts/security-fuzz-campaign.mjs --profile nightly",
    "test:response-indistinguishability-nightly": "KOVO_RESPONSE_TIMING_ORACLE=1 vitest --run security/response-indistinguishability.nightly.test.ts --reporter=dot",
    "test:security-fuzz-release": "node scripts/security-fuzz-campaign.mjs --profile release",
    "symbols": "node scripts/exported-symbols.mjs"
  },
  "devDependencies": {
    "@kovojs/test": "workspace:*",
    "@node-rs/argon2": "2.0.2",
    "@playwright/test": "1.60.0",
    "@types/node": "25.9.2",
    "@typescript/native-preview": "7.0.0-dev.20260610.1",
    "@vitest/browser-playwright": "4.1.10",
    "esbuild": "0.28.1",
    "moo": "0.5.3",
    "nearley": "2.20.1",
    "oxlint-tsgolint": "0.23.0",
    "pgsql-ast-parser": "12.0.2",
    "playwright": "^1.60.0",
    "ts-morph": "28.0.0",
    "typescript": "6.0.3",
    "undici": "7.28.0",
    "vite-plus": "0.1.24",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.10.0"
  },
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "overrides": {
      "@hono/node-server": "2.0.10",
      "body-parser": "2.3.0",
      "brace-expansion": "5.0.8",
      "esbuild": "0.28.1",
      "fast-uri": "3.1.4",
      "hono": "4.12.27"
    },
    "onlyBuiltDependencies": [
      "@node-rs/argon2",
      "better-sqlite3"
    ]
  }
}
